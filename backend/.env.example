# ============================================================================
#  QUIZ BÍBLICO — PROFETAS MENORES · backend/.env.example
#  Copie para backend/.env  →  cp .env.example .env
#  NUNCA faça commit do arquivo .env  (já está no .gitignore)
# ============================================================================

# ############################################################################
# #  DESENVOLVIMENTO (mínimo para rodar local sem Supabase)                  #
# ############################################################################
PORT=8787
NODE_ENV=development

# Driver de banco:
#   local    -> memória + JSON (backend/data/local-db.json). Sem credenciais.
#   supabase -> PostgreSQL real (obrigatório em produção).
DB_DRIVER=local
LOCAL_DB_FILE=./data/local-db.json

# Origens permitidas no CORS (vírgula). Em dev, o Vite roda em 5173.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Segredos de dev (troque por valores aleatórios se quiser):
TOKEN_SECRET=dev-token-secret-troque-me
ADMIN_TOKEN=dev-admin-troque-me

# Regras de jogo (iguais em dev e produção)
MIN_ANSWER_INTERVAL_MS=1200
ATTEMPT_TTL_SECONDS=14400
MAX_DURATION_SECONDS=7200
QUIZ_SIZE=20
QUIZ_DISTRIBUTION=facil:6,medio:8,dificil:6

# Rate limit (janela em minutos / máximos por janela)
RATE_WINDOW_MINUTES=15
RATE_MAX=400
RATE_MAX_QUIZ=180
RATE_MAX_ADMIN=120
RATE_MAX_AUTH=20
RATE_MAX_START=40
RATE_MAX_ANSWER=90

# Logs: dev | combined | common | off
HTTP_LOG=dev

# ############################################################################
# #  PRODUÇÃO (Render/Railway/VPS) — substitua os valores abaixo              #
# ############################################################################
# NODE_ENV=production
# DB_DRIVER=supabase
#
# # Porta: NÃO fixe em produção — Render/Railway injetam PORT automaticamente.
# # PORT=<definido pela plataforma>
#
# # Domínio REAL do frontend (Vercel). Sem barra final. Nunca "*" em produção.
# CORS_ORIGIN=https://SEU-FRONTEND.vercel.app
#
# # Supabase → Project Settings → API
# SUPABASE_URL=https://SEU-PROJETO.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=cole-aqui-sua-chave-service-role   # SEGREDO — só no backend
# SUPABASE_ANON_KEY=cole-aqui-sua-chave-anon                    # informativa na v1.0
#
# # Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# TOKEN_SECRET=cole-aqui-um-segredo-longo-aleatorio
# ADMIN_TOKEN=cole-aqui-um-token-forte-de-admin
#
# HTTP_LOG=combined
